{
  "extends": "tsconfig/javascript-library.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "lib": [
      "esnext",
      "dom"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "build",
    "node_modules",
    "**/__tests__/*",
    "**/*.test.ts"
  ]
}
