{
  "name": "farcaster-client-data",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "sideEffects": false,
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\" --config ../../.prettierrc.js --ignore-path ../../.prettierignore",
    "generateFarcasterClient": "ts-node --project=tsconfig.node.json bin/generateFarcasterClient.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "canonicalize": "2.0.0",
    "eventemitter3": "^5.0.1",
    "lodash": "4.18.1",
    "ox": "^0.6.3",
    "qs": "6.14.2"
  },
  "peerDependencies": {
    "viem": "2.x",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@farcaster/miniapp-core": "0.6.0",
    "@types/jest": "29.5.5",
    "@types/js-yaml": "4.0.6",
    "@types/lodash": "4.14.199",
    "@types/qs": "6.9.8",
    "eslint-config-custom": "workspace:*",
    "jest": "29.7.0",
    "js-yaml": "4.1.1",
    "lodash": "4.18.1",
    "ts-jest": "29.3.2",
    "ts-node": "10.9.1",
    "tsconfig": "workspace:*",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "viem": "2.39.3",
    "zod": "^4.3.6",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
