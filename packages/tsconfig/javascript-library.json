{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Javascript Library",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "removeComments": false,
    "noImplicitReturns": true
  }
}
