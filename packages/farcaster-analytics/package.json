{
  "name": "farcaster-analytics",
  "version": "0.0.0",
  "main": "dist/index.js",
  "license": "UNLICENSED",
  "sideEffects": false,
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\" --config ../../.prettierrc.js --ignore-path ../../.prettierignore",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit"
