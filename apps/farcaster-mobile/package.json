{
  "name": "farcaster-mobile",
  "version": "1.0.0",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-image"
        ]
      }
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "DISABLE_COMMIT_PAUSING_MECHANISM": true
    }
  },
  "scripts": {
    "android:internal": "ts-node --project=tsconfig.node.json ./src/bin/expo-build.ts --platform android --profile internal",
    "android:production": "ts-node --project=tsconfig.node.json ./src/bin/expo-build.ts --platform android --profile production",
    "android:production-apk": "ts-node --project=tsconfig.node.json ./src/bin/expo-build.ts --platform android --profile production-apk",
    "android:local": "eas build --platform android --profile local --local",
    "android": "expo run:android -d",
    "device:create": "eas device:create",
    "device:list": "eas device:list",
    "e2e:install": "curl -Ls 'https://get.maestro.mobile.dev' | bash",
    "e2e:studio": "maestro studio",
    "e2e:ios": "bash .maestro/bin/run-maestro.sh ios",
    "e2e:android": "bash .maestro/bin/run-maestro.sh android",
    "eas-build-pre-install": "node ./src/bin/validate-build-env.cjs",
    "eas-build-post-install": "pnpm --workspace-root build:packages",
    "eject": "expo eject",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\" --config ../../.prettierrc.js --ignore-path ../../.prettierignore",
    "ios:internal": "ts-node --project=tsconfig.node.json ./src/bin/expo-build.ts --platform ios --profile internal",
    "ios:local": "eas build --platform ios --profile local --local",
    "ios:production": "ts-node --project=tsconfig.node.json ./src/bin/expo-build.ts --platform ios --profile production",
    "ios:simulator": "eas build -p ios --profile simulator",
    "ios": "expo run:ios -d",
    "lint:fix": "eslint --fix src --max-warnings 1750",
    "lint": "eslint src --quiet --max-warnings 1750",
    "ota": "NODE_OPTIONS=--max-old-space-size=12288 ts-node --project=tsconfig.node.json ./src/bin/ota.ts",
    "ota-tf": "NODE_OPTIONS=--max-old-space-size=12288 ts-node --project=tsconfig.node.json ./src/bin/ota.ts",
    "release:ios": "ts-node --project=tsconfig.node.json ./src/bin/release.ts ios",
    "release:android": "ts-node --project=tsconfig.node.json ./src/bin/release.ts android",
    "release:both": "ts-node --project=tsconfig.node.json ./src/bin/release-both.ts",
    "start": "expo start --dev-client --clear",
    "test-watch": "jest --watchAll",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "version:bump": "ts-node --project=tsconfig.node.json ./src/bin/update-version.ts",
    "web": "expo start --web"
  },
